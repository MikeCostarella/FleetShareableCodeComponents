# Normalize line endings: store text files as LF in the repo and check them
# out as LF everywhere (prevents the "LF -> CRLF" diff churn on Windows).
* text=auto eol=lf

# Treat these as binary so git never touches their bytes or line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
